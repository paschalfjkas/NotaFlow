# --- Supabase ---------------------------------------------------------------
# Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider -------------------------------------------------------------
# Which provider lib/ai/providers resolves to at runtime: "openai" | "gemini" | "perplexity"
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# --- Paystack ----------------------------------------------------------------
# Dashboard > Settings > API Keys & Webhooks.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Storage -------------------------------------------------------------
# Supabase Storage bucket used for generated .docx files and uploaded screenshots.
STORAGE_BUCKET=siwes-reports

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- E2E tests (optional) -----------------------------------------------------
# Only needed to run `npm run test:e2e`. e2e/global-setup.ts provisions this
# account automatically (via the Supabase service role key above) — just pick
# any email/password here and it creates the account on first run.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
